# Google AI Studio API Key (Pro Plan)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,tauri://localhost,http://127.0.0.1:3000

# Model Paths & Local Inference
KOKORO_MODEL_PATH=./models/kokoro
ORPHEUS_SERVER_URL=http://127.0.0.1:8081
