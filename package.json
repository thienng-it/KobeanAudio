{
  "name": "kobeanaudio-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:web": "pnpm --filter @kobeanaudio/web dev",
    "dev:api": "cd apps/api && python3 -m uvicorn main:app --reload --reload-exclude '.venv*' --port 8000",
    "dev:desktop": "bash scripts/desktop.sh",
    "desktop": "bash scripts/desktop.sh",
    "tauri": "pnpm --filter @kobeanaudio/desktop tauri",
    "build": "pnpm --filter @kobeanaudio/web build",
    "lint": "pnpm --filter @kobeanaudio/web lint && uvx ruff check apps/api",
    "lint:fix": "pnpm --filter @kobeanaudio/web lint --fix && uvx ruff check --fix apps/api && uvx ruff format apps/api",
    "format": "prettier --write . && uvx ruff format apps/api",
    "format:check": "uvx ruff format --check apps/api",
    "test": "pnpm --filter @kobeanaudio/web test && cd apps/api && source .venv/bin/activate && python3 -m pytest",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "prettier": "^3.5.0",
    "typescript": "^5.7.3"
  }
}
